# ==============================================================================
# ParentingHub (parentinghub.pk) - Google Business Profile Agent Configuration
# ==============================================================================

# Google Gemini AI Configuration
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7

# Google Business Profile (GBP) OAuth2 Credentials
# Set up in Google Cloud Console -> APIs & Services -> Credentials (OAuth 2.0 Client ID)
# Scopes needed: https://www.googleapis.com/auth/business.manage
CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_oauth_client_secret
REFRESH_TOKEN=your_oauth_refresh_token

# Google Business Profile Target Location ID
LOCATION_ID=locations/17062544117938448005

# Call To Action Button for GBP Posts
CTA_ACTION=LEARN_MORE
CTA_URL=https://parentinghub.pk/

# Automated Background Schedule
# Day of week: monday, tuesday, wednesday, thursday, friday, saturday, sunday
SCHEDULE_DAY=monday
SCHEDULE_TIME=10:00

# Debug / Verbose Logging
DEBUG=false

# Make.com / Buffer Webhook Integration (Optional alternative to direct Google API)
GBP_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id

# Discord Webhook Notifier (Employee-style daily reports)
# Create a webhook in your Discord channel: Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
